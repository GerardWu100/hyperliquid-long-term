# Hyperliquid ClickHouse connection settings.
#
# Copy this file to .env on the machine that runs the loader, then edit the
# values. Do not commit .env because it contains a password.

# ClickHouse host name or IP address reachable from this runtime.
#
# Local ``uv run`` (ClickHouse published on the host):
#   IVYDB_CLICKHOUSE_HOST=localhost
#   IVYDB_CLICKHOUSE_PORT=50050
#
# Docker on the shared ``single`` network (use the ClickHouse *container name*
# from ``docker ps``, and the internal HTTP port, not the host-published port):
#   IVYDB_CLICKHOUSE_HOST=clickhouse
#   IVYDB_CLICKHOUSE_PORT=8123
IVYDB_CLICKHOUSE_HOST=localhost

# ClickHouse HTTP interface port.
IVYDB_CLICKHOUSE_PORT=8123

# ClickHouse user scoped to IVYDB_CLICKHOUSE_DATABASE. Required grants on that
# database: SELECT, INSERT, CREATE TABLE, ALTER TABLE. CREATE DATABASE is
# optional when the database is pre-created by an admin.
IVYDB_CLICKHOUSE_USERNAME=hyperliquid_user

# ClickHouse password matching the user XML or SQL-managed user.
# If the password contains a `$`, keep it in this file (do not `export` it from a
# shell, where `$` triggers variable expansion and silently corrupts the value).
# The service reads this file as the authoritative source for connection values.
IVYDB_CLICKHOUSE_PASSWORD=replace-me

# Set true only when using HTTPS/TLS for the ClickHouse HTTP interface.
IVYDB_CLICKHOUSE_SECURE=false

# Target database for hyperliquid tables.
IVYDB_CLICKHOUSE_DATABASE=hyperliquid
